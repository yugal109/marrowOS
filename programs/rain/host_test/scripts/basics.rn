fun add(a, b) {
    return a + b;
}
print add(2, 3);
fun fact(n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}
print fact(10);
fun fib(n) {
    if (n < 2) return n;
    return fib(n - 1) + fib(n - 2);
}
print fib(20);
for (var i = 0; i < 3; i = i + 1) {
    print i;
}
var i = 0;
while (i < 3) { i = i + 1; }
print i;
